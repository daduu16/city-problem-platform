{
  "name": "municipal-incident-platform",
  "private": true,
  "scripts": {
    "start": "node scripts/start-all.js",
    "start:all": "npm start",
    "db:init": "node scripts/init-db.js",
    "db:verify": "node scripts/verify-db.js",
    "db:reset": "node scripts/init-db.js -- --reset --force-seed",
    "init": "npm run db:init",
    "setup": "npm run db:init",
    "install:all": "node scripts/install-all.js --force",
    "setup:env": "node scripts/lib/env.js",
    "setup:db": "node scripts/setup-db.js",
    "dev:infra": "node scripts/lib/env.js && docker compose up -d --wait postgres redis",
    "dev:backend": "node scripts/lib/env.js && node scripts/setup-db.js && npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:mobile": "npm start --prefix mobile",
    "dev": "npm run dev:infra && npx concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "postinstall": "node -e \"try{require('./scripts/lib/env').ensureProjectEnv()}catch(e){}\"",
    "places:extract": "npm run places:extract --prefix backend",
    "district:extract": "npm run district:extract --prefix backend",
    "opendata:extract": "npm run opendata:extract --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
