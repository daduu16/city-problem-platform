# Database (Docker: host POSTGRES_PORT -> container 5432)
POSTGRES_USER=municipal
POSTGRES_PASSWORD=municipal_secret
POSTGRES_DB=municipal_incidents
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql://municipal:municipal_secret@localhost:5434/municipal_incidents?schema=public

# Redis
REDIS_URL=redis://localhost:6380

# Backend
PORT=3001
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
PUBLIC_API_URL=http://localhost:3001
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Frontend (Vite)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001
VITE_MAPBOX_TOKEN=

# Mobile (Expo) — run `npm run setup:env` to set LAN IP for a physical phone
EXPO_PUBLIC_API_URL=http://localhost:3001
