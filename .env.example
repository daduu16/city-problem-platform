# Database (Docker maps host port POSTGRES_PORT -> container 5432; do not use 5432 in DATABASE_URL unless you changed POSTGRES_PORT)
POSTGRES_USER=municipal
POSTGRES_PASSWORD=municipal_secret
POSTGRES_DB=municipal_incidents
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql://municipal:municipal_secret@localhost:5434/municipal_incidents?schema=public

# Redis
REDIS_URL=redis://localhost:6380

# Backend
PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Mobile (Expo) — auto-synced to mobile/.env with LAN IP; override for a fixed host
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001

# Mapbox (frontend)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001
VITE_MAPBOX_TOKEN=
